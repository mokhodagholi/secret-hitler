{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "noEmit": true
  },
  "include": ["src", "test"],
  // *.test.ts files import the ESM-only rstest runner, which TS rejects under
  // node16 CJS resolution. They are compiled and run by rstest's own pipeline.
  "exclude": ["**/*.test.ts"]
}
