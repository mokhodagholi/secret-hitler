# Copy to .env and adjust. Server-side only.

# HTTP + WebSocket port for the game server.
PORT=3001

# Minimum players required to start a game. Unset = standard Secret Hitler
# rules (5). Lower it for local testing; the role distribution supports down
# to 3. Example: start a game with 3 players.
MIN_PLAYERS=5

# Postgres connection for game-history persistence. REQUIRED — the server
# refuses to start without it. Matches the docker-compose.yml service: run
# `docker compose up -d` then `pnpm --filter @secret-hitler/server db:migrate`.
DATABASE_URL=postgres://secret_hitler:secret_hitler@localhost:5432/secret_hitler

# Public HTTPS origin of this server (nginx). Used for share links on the
# website and the mini-app itself — bot chat links never include this.
PUBLIC_URL=https://mrfantastic.ir

# Bale bot token from @botfather. Leave empty to run without the bot.
BALE_BOT_TOKEN=

# HTTPS webhook Bale should POST updates to (ports 443 or 88 only).
BALE_WEBHOOK_URL=https://mrfantastic.ir/api/bale/webhook

# Bot username as shown in Bale. Deep links in chat are
# https://ble.ir/@secret_hitler_bot?start=
BALE_BOT_USERNAME=@secret_hitler_bot
