# Copy to .env and adjust. Server-side only.

# HTTP + WebSocket port for the game server.
PORT=3001

# Postgres. Compose reads POSTGRES_* for the database container and builds
# DATABASE_URL for the game server. Use a long random password on the VPS.
POSTGRES_USER=secret_hitler
POSTGRES_PASSWORD=change-me
POSTGRES_DB=secret_hitler
DATABASE_URL=postgres://secret_hitler:change-me@localhost:5432/secret_hitler

# Public HTTPS origin of this server (nginx). The mini-app itself loads here.
# Production invites are Bale `ble.ir` or Telegram `t.me` deep links.
# Localhost copies `https://localhost…/join/CODE` so the browser can open it.
PUBLIC_URL=https://mrfantastic.ir

# Bale bot token from @botfather. Leave empty to run without the bot.
BALE_BOT_TOKEN=

# HTTPS webhook Bale should POST updates to (ports 443 or 88 only).
BALE_WEBHOOK_URL=https://mrfantastic.ir/api/bale/webhook

# Opt-in for setWebhook on boot. Production compose sets this true. Leave
# unset for local `pnpm dev` — otherwise a missing secret re-registers Bale
# at an open URL and chat commands stop getting replies (401 on the VPS).
BOT_SET_WEBHOOK=

# Random token (A–Z, a–z, 0–9, _ or -). The server appends it to the webhook
# URL and rejects posts that do not present it as a path segment or as the
# X-Telegram-Bot-Api-Secret-Token header. Required when BOT_SET_WEBHOOK=true.
BALE_WEBHOOK_SECRET=

# Bot username as shown in Bale. Mini-app deep links in chat are
# https://ble.ir/secret_hitler_bot?startapp=  (room code or any later payload)
BALE_BOT_USERNAME=@secret_hitler_bot

# Group the bot posts support letters to. Add the bot to the group, then put
# the group's chat id here (usually a negative number). Leave empty to disable.
BALE_SUPPORT_CHAT_ID=5829149569

# Group (or chat) that receives Postgres dumps + a copy of this .env every
# BACKUP_INTERVAL_SECONDS. Add the bot to the group first. Leave empty to skip
# sending (loop still runs). Keep that chat private — the .env has bot tokens.
BALE_BACKUP_CHAT_ID=

# Seconds between db-backup dumps (compose service `db-backup`). Default 15m.
BACKUP_INTERVAL_SECONDS=900

# Telegram bot token from @BotFather. Leave empty to run without Telegram.
TELEGRAM_BOT_TOKEN=

# HTTPS webhook Telegram should POST updates to.
TELEGRAM_WEBHOOK_URL=https://mrfantastic.ir/api/telegram/webhook

# Random token (A–Z, a–z, 0–9, _ or -). Same rules as BALE_WEBHOOK_SECRET.
TELEGRAM_WEBHOOK_SECRET=

# Bot username as shown in Telegram. Mini-app deep links in chat are
# https://t.me/secret_hitler_bot/game?startapp=CODE
TELEGRAM_BOT_USERNAME=@secret_hitler_bot

# BotFather Mini App short name (`/newapp`). Direct links use this path segment.
TELEGRAM_WEBAPP_SHORT_NAME=game

# Group the Telegram bot posts support letters to. Leave empty to disable.
TELEGRAM_SUPPORT_CHAT_ID=

# Optional. Leave empty — ./scripts/deploy.sh sets this from git for each rebuild.
APP_VERSION=

# Feature flags. Empty or omitted keeps the catalog default. Set
# FEATURE_VOICE=true to enable table voice when that work ships.
# FEATURE_PUBLIC_TABLE=true for one Join salon (host Start 5–10). Default off.
# FEATURE_LOBBY_KICK=true to let hosts (and the public table) kick in lobby.
# FEATURE_GAME_KICK=true to allow in-game kick votes (and host kick mid-game).
# FEATURE_ONBOARDING=true to offer the first-run look table after splash.
# FEATURE_ROOM_PASSWORD=true to let create/join lock a room with a password.
# FEATURE_LOBBY_FILL=true to DM warm players into waiting 2–4 seat lobbies.
FEATURE_VOICE=
FEATURE_PUBLIC_TABLE=
FEATURE_LOBBY_KICK=
FEATURE_GAME_KICK=
FEATURE_ONBOARDING=
FEATURE_ROOM_PASSWORD=
FEATURE_LOBBY_FILL=

# Bale user ids that may run hidden admin commands (/play-game, /broadcast, /message, /unsend, /users, /delete).
# 1902004260 is always included.
ADMIN_USER_IDS=1902004260

# mediasoup (used only when FEATURE_VOICE=true). The game server uses host
# networking so this UDP range binds on the VPS. Do not publish it as a
# Docker port map — a thousand ports OOMs the box and 443 dies.
# ANNOUNCED_IP is the address browsers will send RTP to:
#   pnpm dev, same machine → 127.0.0.1
#   phone on the LAN     → this machine's Wi-Fi IP
#   production           → the box's public IPv4
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40999

# ICE. STUN is optional. TURN is required for most mobile NATs.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
